# Pinned versions of everything built by deploy-host (copied into every host's .env by gen-config).
# OptimusDB: git URL#ref of your repository, or a local path to a checkout containing its Dockerfile.
# ref = a branch name (main: builds the latest pushed commit) or a commit hash (fixed, reproducible).
# For the paper's final campaign, replace main with the full commit hash you pushed, so every run uses the same code.
# Pinned 2026-10-17 to the build of quick run 6 and the pilot (479504d "major change for H5 and replication").
# To test newer OptimusDB code, push it and replace the hash (or use #main while developing).
OPTIMUSDB_SRC=https://github.com/georgeGeorgakakos/optimusdb.git#479504d17e1d85ffbba6ee31ef173a9a98ac119c
CORROSION_REF=ef243dd16dc0878122c22edad834a6240abbe4c1
OPENDHT_REF=v4.4.1
GUN_VERSION=0.2020.1239
AUTOBASE_VERSION=7.28.2
IROH_DOCS_VERSION=0.101.0
