=3;strokeColor=#6C8EBF;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontSize=9;labelBackgroundColor=#F5F5F5;" edge="1" parent="1" source="c52" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c97" value="cloud ↔ fog&lt;br&gt;20 ms ± 4 · 0.1 % loss&lt;br&gt;100 Mbit/s" style="startArrow=classic;endArrow=classic;html=1;dashed=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;fontFamily=Helvetica;strokeColor=#9673A6;exitX=1;exitY=0.6;entryX=1;entryY=0.3;" edge="1" parent="1" source="c10" target="c31"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1176" y="278.79999999999995"/><mxPoint x="1176" y="524.4"/></Array></mxGeometry></mxCell><mxCell id="c98" value="fog ↔ edge&lt;br&gt;50 ms ± 10 · 0.5 % loss&lt;br&gt;10 Mbit/s" style="startArrow=classic;endArrow=classic;html=1;dashed=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;fontFamily=Helvetica;strokeColor=#82B366;exitX=1;exitY=0.75;entryX=0.608;entryY=0;" edge="1" parent="1" source="c31" target="c52"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1276" y="663.0"/></Array></mxGeometry></mxCell><mxCell id="c99" value="cloud ↔ edge (derived)&lt;br&gt;70 ms ± 11 · 0.6 % loss&lt;br&gt;10 Mbit/s" style="startArrow=classic;endArrow=classic;html=1;dashed=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;fontFamily=Helvetica;strokeColor=#D79B00;exitX=1;exitY=0.25;entryX=0.722;entryY=0;" edge="1" parent="1" source="c10" target="c52"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1436" y="171.0"/></Array></mxGeometry></mxCell><mxCell id="c100" value="Legend and notes" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;arcSize=2;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#CCCCCC;" vertex="1" parent="c3"><mxGeometry x="20" y="400" width="300" height="470" as="geometry"/></mxCell><mxCell id="c101" value="" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="c100"><mxGeometry x="12" y="34" width="30" height="18" as="geometry"/></mxCell><mxCell id="c102" value="attachment to the Docker bridge (all traffic)" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="c100"><mxGeometry x="50" y="26" width="240" height="40" as="geometry"/></mxCell><mxCell id="c103" value="" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;dashed=1;strokeWidth=2;" vertex="1" parent="c100"><mxGeometry x="12" y="80" width="30" height="18" as="geometry"/></mxCell><mxCell id="c104" value="emulated link profile (tc netem on eth0,&lt;br&gt;per destination IP)" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="c100"><mxGeometry x="50" y="72" width="240" height="40" as="geometry"/></mxCell><mxCell id="c105" value="" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;" vertex="1" parent="c100"><mxGeometry x="12" y="126" width="30" height="18" as="geometry"/></mxCell><mxCell id="c106" value="data-store container (created; started&lt;br&gt;only for the system under test)" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="c100"><mxGeometry x="50" y="118" width="240" height="40" as="geometry"/></mxCell><mxCell id="c107" value="&lt;b&gt;Per run (harness → agents)&lt;/b&gt;&lt;br&gt;1. stop all data stores on all hosts&lt;br&gt;2. wipe the system's volumes&lt;br&gt;3. start it on all 8 hosts and join:&lt;br&gt;&amp;nbsp;&amp;nbsp;OptimusDB libp2p connect · Corrosion gossip&lt;br&gt;&amp;nbsp;&amp;nbsp;bootstrap · Gun peers · Autobase TCP repl. +&lt;br&gt;&amp;nbsp;&amp;nbsp;writers · Iroh ticket · OpenDHT bootstrap&lt;br&gt;4. smoke test: write on cloud-a, read on edge-d&lt;br&gt;5. load / faults / sampling, then results CSV&lt;br&gt;&lt;br&gt;&lt;b&gt;Faults&lt;/b&gt;: E5 partitions = iptables DROP between&lt;br&gt;host groups (e.g. cloud+fog | edge); bench is never&lt;br&gt;blocked.&lt;br&gt;&lt;br&gt;&lt;b&gt;Containers&lt;/b&gt;: 17 running (bench, 8 × net, 8 ×&lt;br&gt;agent) · 48 created (8 hosts × 6 data stores)." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=10;spacingLeft=4;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="c100"><mxGeometry x="12" y="176" width="276" height="284" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>