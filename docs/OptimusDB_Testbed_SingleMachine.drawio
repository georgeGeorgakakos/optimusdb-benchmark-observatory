<mxfile host="app.diagrams.net"><diagram id="local" name="Single-machine testbed"><mxGraphModel dx="1900" dy="1330" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1360" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;OptimusDB evaluation testbed — single machine (Docker Desktop on Windows)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;8 emulated hosts + bench on one private Docker bridge network · only the system under test runs · Table 7 links emulated with tc/netem on each host's eth0 · partitions with iptables&lt;/font&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1860" height="44" as="geometry"/></mxCell><mxCell id="c3" value="Windows PC  ›  Docker Desktop (WSL2 VM, e.g. 12 CPUs / 25 GB from .wslconfig)" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;arcSize=2;fontFamily=Helvetica;fontSize=13;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="64" width="1860" height="1246" as="geometry"/></mxCell><mxCell id="c4" value="bench  ·  10.88.0.2" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;arcSize=2;fontFamily=Helvetica;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="c3"><mxGeometry x="20" y="50" width="300" height="330" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;odb-bench&lt;/b&gt;&lt;br&gt;optimusdb-bench harness&lt;br&gt;&lt;i&gt;open-loop load generator, cluster control,&lt;br&gt;netem / partitions, result CSVs&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontFamily=Helvetica;" vertex="1" parent="c4"><mxGeometry x="12" y="32" width="276" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Bind mounts (Windows folders)&lt;/b&gt;&lt;br&gt;out-local\config → /config (testbed.yaml)&lt;br&gt;results → /results (E*_raw.csv, ops, logs)&lt;br&gt;trace → /trace (E6 trace.jsonl)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;fontFamily=Helvetica;" vertex="1" parent="c4"><mxGeometry x="12" y="112" width="276" height="100" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Talks to every host&lt;/b&gt;&lt;br&gt;• control: HTTP :9100 (agent, x-token)&lt;br&gt;• data: system API ports (load, queries)&lt;br&gt;• load enters at cloud-a (edge-a for E4)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#FFFFFF;strokeColor=#999999;fontFamily=Helvetica;" vertex="1" parent="c4"><mxGeometry x="12" y="222" width="276" height="96" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6C8EBF;strokeColor=#3D5A80;" vertex="1" parent="c3"><mxGeometry x="340" y="50" width="26" height="964" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Docker bridge network &lt;i&gt;odbnet&lt;/i&gt;&lt;/b&gt;&lt;br&gt;10.88.0.0/24 · gateway 10.88.0.1" style="text;html=1;fillColor=none;strokeColor=none;align=center;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="c3"><mxGeometry x="250" y="1020" width="200" height="34" as="geometry"/></mxCell><mxCell id="c10" value="Cloud tier  —  cloud ↔ cloud: 5 ms ± 1 ms · 0 % loss · 1 Gbit/s" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;arcSize=2;fontFamily=Helvetica;fontSize=12;fillColor=#F7F2FA;strokeColor=#9673A6;" vertex="1" parent="c3"><mxGeometry x="400" y="30" width="716" height="308" as="geometry"/></mxCell><mxCell id="c11" value="cloud-a  ·  10.88.0.11" style="rounded=1;wh